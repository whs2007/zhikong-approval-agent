# 智控平台运行环境变量示例（复制为 .env 后按需修改）
# 环境：dev（默认，开发/测试，跳过生产自检） | prod / production（启用密钥合规自检）
ENV=dev

# ---- 安全 ----
# 生产环境（ENV=prod）要求：非空、且 ≠ 代码默认值、长度 ≥32 位随机串。
# 生成：openssl rand -hex 32
# 若使用默认值/空/过短，进程将在启动时直接退出（拒绝带病上线）。
SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# ---- 数据库 ----
DB_URL=sqlite:///data/db/zhikong.db
AUDIT_DB=data/db/audit.db

# ---- 持久化检查点 ----
# sqlite（默认，文件持久化） | memory（仅测试） | postgres
CHECKPOINTER=sqlite
CHECKPOINTER_DB=data/db/checkpoints.db
POSTGRES_URL=

# ---- RAG / LLM ----
# local（默认，零依赖离线） | st | openai | dashscope
EMBEDDING_PROVIDER=local
LLM_PROVIDER=rule
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
ST_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=3
EMBED_DIM=256

# ---- 工作流阈值 ----
AUTO_APPROVE_THRESHOLD=5000
MAX_RETRY=3
# 重试退避：基础延迟 / 最大延迟（秒）/ 抖动比例(0~1)
RETRY_BASE_DELAY_SECONDS=0.2
RETRY_MAX_DELAY_SECONDS=5.0
RETRY_JITTER=0.3
HIGH_RISK_THRESHOLD=50000
MEDIUM_RISK_THRESHOLD=5000

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
