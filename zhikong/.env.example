# 智控平台运行环境变量示例（复制为 .env 后按需修改）
# 环境：dev（默认，开发/测试，跳过生产自检） | prod / production（启用密钥合规自检）
ENV=dev

# ---- 安全 ----
# 生产环境（ENV=prod）要求：非空、长度 ≥32 位随机串。缺失/过短 -> 启动即退出。
# 生成：openssl rand -hex 32
# 开发环境留空即可：会自动生成随机密钥并存入 data/db/.dev_secret（已 gitignore）。
# ⚠️ 切勿把真实密钥写进本文件（本文件会入库），仅在部署环境注入。
SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# ---- 演示账号种子（默认关闭） ----
# 仅 ENV ∈ {dev,development,local,test} 且 DEMO_SEED=1 时创建 admin/approver01/applicant01。
# 口令必须由此处注入；留空则随机生成并打印到启动日志。生产环境开启会拒绝启动。
DEMO_SEED=0
DEMO_ADMIN_PASSWORD=
DEMO_APPROVER_PASSWORD=
DEMO_APPLICANT_PASSWORD=

# ---- 数据库 ----
DB_URL=sqlite:///data/db/zhikong.db
AUDIT_DB=data/db/audit.db

# ---- 持久化检查点 ----
# sqlite（默认，文件持久化） | memory（仅测试） | postgres
CHECKPOINTER=sqlite
CHECKPOINTER_DB=data/db/checkpoints.db
POSTGRES_URL=

# ---- RAG / LLM ----
# local（默认，零依赖离线） | st | openai | dashscope
EMBEDDING_PROVIDER=local
LLM_PROVIDER=rule
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
ST_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=3
EMBED_DIM=256
# 向量后端：auto（有 faiss 用 faiss，否则降级 numpy）| faiss（强制，缺失即启动失败）| numpy
VECTOR_BACKEND=auto
# 索引规模阈值：<= 该值用 IndexFlatIP（精确），超过切 IndexIVFFlat（需训练）
FAISS_FLAT_MAX=20000
FAISS_NLIST=64
FAISS_NPROBE=8
# IVF 训练与查询的簇数；FAISS_INDEX_PATH 留空表示仅内存（启动时重建）
FAISS_INDEX_PATH=

# ---- 工作流阈值 ----
AUTO_APPROVE_THRESHOLD=5000
MAX_RETRY=3
# 重试退避：基础延迟 / 最大延迟（秒）/ 抖动比例(0~1)
RETRY_BASE_DELAY_SECONDS=0.2
RETRY_MAX_DELAY_SECONDS=5.0
RETRY_JITTER=0.3
HIGH_RISK_THRESHOLD=50000
MEDIUM_RISK_THRESHOLD=5000

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
